{
  "name": "omniask",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "OmniAsk - 一次提问，多模型回答，交叉验证，生成最佳答案",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && npm run icons && npm run build:pages && npm run build:background && npm run build:content && npm run verify",
    "verify": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "package": "npm run build && node scripts/package-extension.mjs",
    "build:pages": "vite build --mode pages",
    "build:background": "vite build --mode background",
    "build:content": "vite build --mode content",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^3.0.0"
  }
}
